generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  QUOTED
  CONTACTED
  CLOSED
}

enum InquiryType {
  GENERAL
  TRIP_PLAN
  PACKAGE
  DESTINATION
  SERVICE
}

enum MediaProvider {
  LOCAL
  CLOUDINARY
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  inquiries    Inquiry[]
}

model Destination {
  id               String    @id @default(cuid())
  slug             String    @unique
  name             String
  state            String
  region           String?
  country          String?
  isInternational  Boolean   @default(false)
  summary          String?
  description      String?   @db.Text
  bestTimeToVisit  String?   @db.Text
  bestMonths       Json?
  entryInfo        String?   @db.Text
  image            String?
  imageAlt         String?
  focalX           Int?
  focalY           Int?
  gallery          Json?
  seoTitle         String?
  seoDescription   String?
  published        Boolean   @default(false)
  featured         Boolean   @default(false)
  order            Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  packages         Package[]
  galleryItems     GalleryItem[]

  @@index([published, order])
  @@index([state])
  @@index([region])
  @@index([isInternational])
}

model Package {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  summary         String?
  description     String?   @db.Text
  destinationId   String?
  destination     Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  durationDays    Int       @default(1)
  durationLabel   String?
  price           Int?
  currency        String    @default("INR")
  priceNote       String?
  tripType        String?
  budgetBand      String?
  bestMonths      Json?
  highlights      Json?
  inclusions      Json?
  exclusions      Json?
  image           String?
  imageAlt        String?
  gallery         Json?
  seoTitle        String?
  seoDescription  String?
  published       Boolean   @default(false)
  featured        Boolean   @default(false)
  order           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  itinerary       PackageItineraryDay[]

  @@index([published, order])
  @@index([destinationId])
  @@index([durationDays])
  @@index([price])
}

model PackageItineraryDay {
  id          String  @id @default(cuid())
  packageId   String
  package     Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  day         Int
  title       String
  description String  @db.Text

  @@index([packageId, day])
}

model Review {
  id         String       @id @default(cuid())
  name       String
  context    String?
  rating     Int
  comment    String       @db.Text
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  approvedAt DateTime?

  @@index([status, createdAt])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  category  String   @default("General")
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
  @@index([category])
}

model Inquiry {
  id               String        @id @default(cuid())
  refId            String?       @unique
  type             InquiryType   @default(GENERAL)
  status           InquiryStatus @default(NEW)
  source           String?
  name             String
  email            String
  phone            String?
  message          String?       @db.Text
  subject          String?
  packageId        String?
  destinationId    String?
  serviceId        String?
  travelDate       DateTime?
  endDate          DateTime?
  travellers       Int?
  budgetRange      String?
  tripType         String?
  specialRequests  String?       @db.Text
  adminNotes       String?       @db.Text
  assigneeId       String?
  assignee         User?         @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  ipHash           String?
  userAgent        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([type])
  @@index([source])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SiteSettings {
  id                String   @id @default("singleton")
  siteName          String   @default("Time to Travel")
  tagline           String?
  fontTheme         String   @default("JOURNAL")
  phone             String?
  whatsapp          String?
  supportPhone      String?
  email             String?
  address           String   @default("Kasumpti, Shimla, Himachal Pradesh, India")
  workingHours      String?
  mapEmbedUrl       String?
  socials           Json?
  heroTitle         String?
  heroSubtitle      String?
  metaTitle         String?
  metaDescription   String?
  ogImage           String?
  footerNote        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PageContent {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String?
  body      String?  @db.Text
  data      Json?
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id        String        @id @default(cuid())
  url       String
  alt       String
  width     Int?
  height    Int?
  provider  MediaProvider @default(LOCAL)
  publicId  String?
  createdAt DateTime      @default(now())
}

model Service {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  icon              String?
  color             String?
  shortDescription  String?  @db.Text
  longDescription   String?  @db.Text
  coverImage        String?
  coverImageAlt     String?
  processSteps      Json?
  faqs              Json?
  linkedPackageSlugs Json?
  seoTitle          String?
  seoDescription    String?
  published         Boolean  @default(false)
  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([published, order])
}

model TripType {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  icon          String?
  color         String?
  description   String?  @db.Text
  coverImage    String?
  coverImageAlt String?
  published     Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, order])
}

model GuidePost {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  excerpt       String?  @db.Text
  body          String?  @db.Text
  category      String   @default("General")
  coverImage    String?
  coverImageAlt String?
  readingMinutes Int?
  seoTitle      String?
  seoDescription String?
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, createdAt])
  @@index([category])
}

model GalleryItem {
  id            String        @id @default(cuid())
  url           String
  alt           String
  category      String        @default("General")
  caption       String?
  destinationId String?
  destination   Destination?  @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  width         Int?
  height        Int?
  order         Int           @default(0)
  createdAt     DateTime      @default(now())

  @@index([category, order])
}

model HomeSection {
  id      String  @id @default(cuid())
  key     String  @unique
  enabled Boolean @default(true)
  order   Int     @default(0)
  config  Json?

  @@index([enabled, order])
}

model TeamMember {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  role      String
  bio       String?  @db.Text
  image     String?
  imageAlt  String?
  isFounder Boolean  @default(false)
  socials   Json?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}
