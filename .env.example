# ── Database (MySQL) ────────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/time_to_travel"

# ── App ─────────────────────────────────────────────────────────────
# Public origin used for absolute URLs (SEO, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Auth (NextAuth / Auth.js) ───────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Optional: custom sign-in URL (default /admin/login)
# AUTH_URL="http://localhost:3000"

# ── Admin seed user (used by `npm run db:seed`) ─────────────────────
SEED_ADMIN_EMAIL="admin@timetotravel.in"
SEED_ADMIN_PASSWORD="change-me-please"
SEED_ADMIN_NAME="Administrator"

# ── Email notifications (optional — Resend) ─────────────────────────
# When unset, form submissions are stored in the DB only.
RESEND_API_KEY=""
ADMIN_NOTIFY_EMAIL=""

# ── Image uploads (optional — Cloudinary) ───────────────────────────
# When unset, images are stored locally in /public/uploads (dev only —
# on Vercel use Cloudinary so uploads persist across deploys).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_UPLOAD_PRESET=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Spam protection ─────────────────────────────────────────────────
# Comma separated IPs that bypass rate limiting (dev convenience)
RATE_LIMIT_EXCLUDE=""

# Optional contact fallbacks (used when SiteSettings fields are empty)
CONTACT_PHONE=+919882726990
CONTACT_WHATSAPP=+918351823736
CONTACT_SUPPORT_PHONE=+919805029089
CONTACT_EMAIL=info@time2travel.com

# ── GURU AI travel assistant (open-source model, server-side only) ──
# Works with ZERO configuration: GURU falls back to free public endpoints
# serving the open-weight GPT-OSS 20B model (api.llm7.io, then
# text.pollinations.ai). Those are third-party free services — fine to get
# started, but visitor messages pass through them and they can rate-limit.
#
# For production, point GURU at an OpenAI-compatible host you control or pay for:
#   Ollama (self-hosted):  GURU_API_URL=http://localhost:11434/v1   GURU_MODEL=llama3.1:8b
#   Groq (free tier):      GURU_API_URL=https://api.groq.com/openai/v1   GURU_MODEL=llama-3.3-70b-versatile   GURU_API_KEY=...
#   OpenRouter:            GURU_API_URL=https://openrouter.ai/api/v1   GURU_MODEL=meta-llama/llama-3.3-70b-instruct   GURU_API_KEY=...
# GURU_API_URL=
# GURU_MODEL=
# GURU_API_KEY=
# GURU_MAX_TOKENS=1800
# GURU_TIMEOUT_MS=30000
# Set to false to switch GURU off entirely
# GURU_ENABLED=true
